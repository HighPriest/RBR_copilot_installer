// installer.rc — wizard pages, strings, manifest, icon, version.
// Layout follows installer/DESIGN.md rev. 2 (seven-scene wizard).
// Control IDs must match src/wizard/control_ids.rs. Polish strings below are UTF-8; keep
// this pragma or they will mojibake.
#pragma code_page(65001)
#include <windows.h>
#include <prsht.h>

// Common Controls v6 + DPI awareness manifest
1 RT_MANIFEST "app.manifest"

// Application icon
// Explorer and the taskbar show the lowest-numbered icon, so IDI_APPICON stays 1.
#define IDI_APPICON 1
IDI_APPICON ICON "../../rbr.ico"

// Version info
// build.rs writes pacenotes_version.h from the release tag, so no version is typed here.
#include "pacenotes_version.h"
VS_VERSION_INFO VERSIONINFO
FILEVERSION     PACENOTES_VERSION_NUMBERS
PRODUCTVERSION  PACENOTES_VERSION_NUMBERS
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"   // US English, Unicode
        BEGIN
            VALUE "CompanyName",      "Pacenotes"
            VALUE "FileDescription",  "Pacenotes Installer for Richard Burns Rally"
            VALUE "FileVersion",      PACENOTES_FILE_VERSION
            VALUE "InternalName",     "pacenotes-installer"
            // Explorer shows this as "Copyright", so it holds LICENSE's copyright line.
            VALUE "LegalCopyright",   "(c) 2026 HighPriest. MIT licensed."
            VALUE "OriginalFilename", "pacenotes-installer.exe"
            VALUE "ProductName",      "Pacenotes Installer"
            VALUE "ProductVersion",   PACENOTES_PRODUCT_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

