// Wizard pages. Each caption here is an English fallback that the wizard replaces from the string table.
// A PropertySheet takes its largest page's size, so every page shares one: 330x215 DLU, for scene 5's three lists.
// The lists are full width because a third of it clips the part of a co-driver's path that tells two voices apart.
LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

IDD_S1_LANGUAGE DIALOGEX 0, 0, 330, 215
STYLE DS_SHELLFONT | DS_3DLOOK | DS_CONTROL | WS_CHILD | WS_DISABLED
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "", IDC_SCENE_TITLE, 14, 8, 302, 12
    LTEXT           "Select language:", IDC_S1_PROMPT, 14, 30, 302, 10
    COMBOBOX        IDC_S1_COMBO, 14, 44, 180, 90,
                    CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    LTEXT           "Restart the application to change language later.",
                    IDC_S1_NOTE, 14, 66, 302, 20
END

IDD_S2_MOTD DIALOGEX 0, 0, 330, 215
STYLE DS_SHELLFONT | DS_3DLOOK | DS_CONTROL | WS_CHILD | WS_DISABLED
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "", IDC_SCENE_TITLE, 14, 8, 302, 12
    EDITTEXT        IDC_S2_MOTD, 14, 24, 302, 132,
                    ES_MULTILINE | ES_READONLY | WS_VSCROLL | NOT WS_TABSTOP
    LTEXT           "Secret:", IDC_S2_SECRET_LABEL, 14, 166, 60, 9
    EDITTEXT        IDC_S2_SECRET, 78, 164, 238, 13, ES_AUTOHSCROLL | ES_PASSWORD
    LTEXT           "", IDC_S2_STATUS, 14, 188, 302, 10
END

IDD_S3_FOLDER DIALOGEX 0, 0, 330, 215
STYLE DS_SHELLFONT | DS_3DLOOK | DS_CONTROL | WS_CHILD | WS_DISABLED
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "", IDC_SCENE_TITLE, 14, 8, 302, 12
    LTEXT           "Game folder:", IDC_S3_PATH_LABEL, 14, 28, 302, 9
    EDITTEXT        IDC_S3_PATH, 14, 40, 244, 13, ES_AUTOHSCROLL
    PUSHBUTTON      "Browse...", IDC_S3_BROWSE, 264, 39, 52, 15
    LTEXT           "Game:", IDC_S3_GAME_LABEL, 14, 66, 302, 9
    COMBOBOX        IDC_S3_GAME, 14, 78, 244, 90,
                    CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    // Two columns: the tall main flow on the right, the secondary pair stacked to match it.
    LTEXT           "", IDC_S3_ROUTES, 14, 98, 302, 30
    PUSHBUTTON      "Configure/Install", IDC_S3_CONFIGURE, 14, 132, 120, 18
    PUSHBUTTON      "Restore/Uninstall", IDC_S3_RESTORE, 14, 154, 120, 18
    DEFPUSHBUTTON   "Download/Update", IDC_S3_DOWNLOAD, 176, 132, 140, 40
END

IDD_S4_DOWNLOAD DIALOGEX 0, 0, 330, 215
STYLE DS_SHELLFONT | DS_3DLOOK | DS_CONTROL | WS_CHILD | WS_DISABLED
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "", IDC_SCENE_TITLE, 14, 8, 302, 12
    CONTROL         "", IDC_S4_TREE, "SysTreeView32",
                    TVS_HASBUTTONS | TVS_HASLINES | TVS_LINESATROOT
                    | TVS_CHECKBOXES | TVS_SHOWSELALWAYS | TVS_DISABLEDRAGDROP
                    | WS_BORDER | WS_TABSTOP,
                    14, 24, 302, 158
    LTEXT           "", IDC_S4_STATUS, 14, 188, 302, 18
END

// Half preview, since restoring is the one thing here that can remove a user's files.
IDD_RESTORE DIALOGEX 0, 0, 330, 215
STYLE DS_SHELLFONT | DS_3DLOOK | DS_CONTROL | WS_CHILD | WS_DISABLED
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "", IDC_SCENE_TITLE, 14, 8, 302, 12
    LTEXT           "", IDC_RESTORE_PROMPT, 14, 26, 302, 18
    LISTBOX         IDC_RESTORE_POINTS, 14, 48, 302, 70,
                    LBS_NOTIFY | WS_BORDER | WS_VSCROLL | WS_TABSTOP
    EDITTEXT        IDC_RESTORE_PREVIEW, 14, 126, 302, 80,
                    ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL
                    | WS_VSCROLL | NOT WS_TABSTOP
END

IDD_S5_CONFIG DIALOGEX 0, 0, 330, 215
STYLE DS_SHELLFONT | DS_3DLOOK | DS_CONTROL | WS_CHILD | WS_DISABLED
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "", IDC_SCENE_TITLE, 14, 8, 302, 12
    LTEXT           "", IDC_S5_LANG_LABEL, 14, 26, 302, 9
    LISTBOX         IDC_S5_LANG, 14, 37, 302, 46,
                    LBS_NOTIFY | WS_BORDER | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_S5_VOICE_LABEL, 14, 90, 302, 9
    LISTBOX         IDC_S5_VOICE, 14, 101, 302, 46,
                    LBS_NOTIFY | WS_BORDER | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_S5_STYLE_LABEL, 14, 154, 302, 9
    LISTBOX         IDC_S5_STYLE, 14, 165, 302, 46,
                    LBS_NOTIFY | WS_BORDER | WS_VSCROLL | WS_TABSTOP
END

IDD_S6_INSTALL DIALOGEX 0, 0, 330, 215
STYLE DS_SHELLFONT | DS_3DLOOK | DS_CONTROL | WS_CHILD | WS_DISABLED
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "", IDC_SCENE_TITLE, 14, 8, 302, 12
    LTEXT           "", IDC_S6_PHASE, 14, 28, 302, 10
    CONTROL         "", IDC_S6_PROGRESS, "msctls_progress32",
                    WS_BORDER, 14, 42, 302, 12
    LTEXT           "", IDC_S6_ITEM, 14, 60, 302, 10
    EDITTEXT        IDC_S6_LOG, 14, 76, 302, 130,
                    ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL
                    | WS_VSCROLL | NOT WS_TABSTOP
END

// Scene 4b, the same screen as scene 6 at an earlier moment, as its own template
// so each page has its own controls and an id for PSM_SETCURSELID.
IDD_S4B_FETCH DIALOGEX 0, 0, 330, 215
STYLE DS_SHELLFONT | DS_3DLOOK | DS_CONTROL | WS_CHILD | WS_DISABLED
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "", IDC_SCENE_TITLE, 14, 8, 302, 12
    LTEXT           "", IDC_S6_PHASE, 14, 28, 302, 10
    CONTROL         "", IDC_S6_PROGRESS, "msctls_progress32",
                    WS_BORDER, 14, 42, 302, 12
    LTEXT           "", IDC_S6_ITEM, 14, 60, 302, 10
    EDITTEXT        IDC_S6_LOG, 14, 76, 302, 130,
                    ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL
                    | WS_VSCROLL | NOT WS_TABSTOP
END

// The log is hidden on success, and the detail block then stretches over it.
IDD_S7_SUMMARY DIALOGEX 0, 0, 330, 215
STYLE DS_SHELLFONT | DS_3DLOOK | DS_CONTROL | WS_CHILD | WS_DISABLED
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "", IDC_SCENE_TITLE, 14, 8, 302, 12
    // Three lines, because the Polish result sentence wraps to three.
    LTEXT           "", IDC_S7_RESULT, 14, 28, 302, 30
    EDITTEXT        IDC_S7_DETAIL, 14, 62, 302, 56,
                    ES_MULTILINE | ES_READONLY | WS_VSCROLL | NOT WS_TABSTOP
    EDITTEXT        IDC_S7_LOG, 14, 124, 302, 82,
                    ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL
                    | WS_VSCROLL | NOT WS_TABSTOP
END

// Strings: one STRINGTABLE per language, and every id must exist in every table.
// Game names are proper nouns, kept untranslated in src/gamedir.rs.
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
STRINGTABLE
BEGIN
    IDS_CONNECTING      "Connecting..."
    IDS_DOWNLOADING     "Downloading: %s"
    IDS_VERIFYING       "Verifying..."
    IDS_BACKUP          "Writing backup"
    IDS_INSTALLING      "Installing: %s"
    IDS_DONE            "Done"
    IDS_READY           "Ready."
    IDS_ALREADY_RUNNING "The Pacenotes Installer is already running.\n\nClose the other window and try again. Two copies would overwrite each other's downloads and installation records."
    IDS_CRASH           "Something went wrong and the installer has to close.\r\n\r\nWhat happened was written to:\r\n%s\r\n\r\nYour game folder has not been left half-installed: anything already written is recorded there too.\r\n\r\nShow that file?"
    IDS_CRASH_NOFILE    "Something went wrong and the installer has to close. It could not write a log, so this is the only copy of what happened:"
    IDS_APP_TITLE       "Pacenotes Installer"

    IDS_BTN_CONTINUE    "Continue"
    IDS_BTN_ACCEPT      "ACCEPT"
    IDS_BTN_NEXT        "Next"
    IDS_BTN_DOWNLOAD    "Download"
    IDS_BTN_INSTALL     "Install"
    IDS_BTN_FINISH      "Finish"
    IDS_BTN_BROWSE      "Browse..."
    IDS_BTN_BACK        "< Back"
    IDS_BTN_CANCEL      "Cancel"
    IDS_CANCEL_CONFIRM  "Stop the installer and close this window?"

    IDS_S1_TITLE        "Language"
    IDS_S1_PROMPT       "Select the language for this installation:"
    IDS_S1_RESTART      "The choice applies to the whole run. Restart the installer to change it."

    IDS_S2_TITLE        "Message of the day"
    IDS_S2_SECRET       "Secret:"
    IDS_S2_CHECKING     "Server status: Checking..."
    IDS_S2_ONLINE       "Server status: Online"
    IDS_S2_OFFLINE      "Server status: Offline"
    IDS_S2_OFFLINE_MOTD "The server could not be reached.\r\n\r\nYou can continue: only content already downloaded to this computer will be available."
    IDS_S2_BADSECRET    "The server did not accept that secret.\n\nClear the field to continue without private content, or correct it and try again."
    IDS_S2_EXPIRING     "This secret expires on %s.\r\n\r\nYou can continue now. Afterwards only public content will be available, so ask for a new secret before that date."

    IDS_S3_TITLE        "Game folder"
    IDS_S3_PATH         "Folder the game is installed in:"
    IDS_S3_GAME         "Detected game:"
    IDS_S3_DETECTING    "(Detecting)"
    IDS_S3_NOGAME       "No supported game was found in that folder.\n\nChoose the folder that contains the game's own executable."
    IDS_S3_DOWNLOAD     "Download/Update"
    IDS_S3_CONFIGURE    "Configure/Install"
    IDS_S3_RESTORE      "Restore/Uninstall"
    IDS_S3_ROUTES       "Download/Update — get new content, then set it up and install it.\r\nConfigure/Install — change what is active using what is already on this computer.\r\nRestore/Uninstall — put this game folder back to an earlier state."

    IDS_S4_TITLE        "Download"
    IDS_S4_LOADING      "Loading the list of available content..."
    IDS_S4_OFFLINE      "The server could not be reached. Showing only content already on this computer."
    IDS_S4_EMPTY        "There is nothing available for this game, online or on this computer."
    IDS_S4_READY        "Tick what you want. Items already on this computer are ticked for you."
    IDS_S4_MISSING      "Choose at least one item in each of: %s"
    IDS_S4_FETCH_FAILED "The list of available content could not be read. Showing only content already on this computer."
    IDS_S4_NEEDS_NEWER  "The server offers content this version of the installer does not understand, so nothing new can be downloaded.\n\nDownload the latest installer to get it. Everything already installed still works: you can change your selection or remove packages without updating."
    IDS_S4B_TITLE       "Downloading"
    IDS_S4B_DONE        "Everything selected is on this computer. Nothing has been installed yet."
    IDS_STATE_DOWNLOADED "(downloaded)"
    IDS_STATE_UPDATE    "(update)"
    IDS_STATE_LOCAL     "(local only)"
    IDS_STATE_INSTALLED "(installed)"
    IDS_STATE_UNAVAILABLE "(installed, no longer available)"

    IDS_S5_TITLE        "Configuration"
    IDS_S5_LANGUAGE     "Pacenotes language:"
    IDS_S5_VOICE        "Co-driver voice:"
    IDS_S5_STYLE        "Pacenotes style:"
    IDS_S5_MISSING      "Choose one option under: %s"
    IDS_S5_NONE         "(nothing was selected on the previous screen)"

    IDS_S6_TITLE        "Installation"
    IDS_S6_DOWNLOADING  "Downloading"
    IDS_S6_BACKUP       "Backing up files that will be replaced"
    IDS_S6_INSTALLING   "Installing"
    IDS_S6_FINISHED     "Finished"
    IDS_S6_NOTHING      "Everything you selected is already on this computer."
    IDS_S6_CANCELLING   "Stopping..."
    IDS_S6_STARTED      "Starting."
    IDS_S6_CHECKING     "Checking the packages and the game folder"
    IDS_S6_UNINSTALLING "Removing what is being replaced"
    IDS_S6_CONFIGURING  "Writing the game's configuration"
    IDS_S6_CONFIRM_REMOVE "These are installed and are no longer selected, so they will be removed from the game folder:\n\n%s\n\nContinue?"

    IDS_S7_TITLE        "Summary"
    IDS_S7_OK           "Installation complete."
    IDS_S7_FAILED       "The installation did not finish: %s"
    IDS_S7_CANCELLED    "Cancelled. Nothing was installed, and the unfinished download was discarded."
    IDS_S7_PENDING_ENGINE "Everything selected was downloaded and verified. Installing it into the game folder is not implemented yet, so the game folder was not touched."
    IDS_S7_GAME         "Game: %s"
    IDS_S7_DOWNLOADS    "Downloaded this run: %s"
    IDS_S7_EXTRAS       "Pacenotes packages: %s"
    IDS_S7_LOGFILE      "Log file: %s"
    IDS_S7_NOTHING_TODO "Nothing needed downloading."
    IDS_S7_CHANGED      "Packages installed / removed: %s"
    IDS_S7_LEFT_ALONE   "Left untouched because something else had changed them: %s"
    IDS_S7_RESTORE_POINT "You can undo this run from the restore point %s"

    IDS_RESTORE_TITLE   "Restore"
    IDS_RESTORE_PROMPT  "Choose the state to go back to. The signs say what the run after that point did: + added, - removed, ~ changed version."
    IDS_RESTORE_ALL     "Remove everything this installer added"
    IDS_RESTORE_EMPTY   "There is nothing to go back to: this installer has not changed anything in this folder yet."
    IDS_RESTORE_PICK    "Choose a state from the list first."
    IDS_RESTORE_PUT_BACK "Put back:\r\n%s"
    IDS_RESTORE_REMOVE  "Remove:\r\n%s"
    IDS_RESTORE_KEEP    "Leave as it is:\r\n%s"
    IDS_RESTORE_MISSING "CANNOT be put back, because its download is no longer on this computer. What is installed now will be left alone:\r\n%s"
    IDS_RESTORE_NOTHING "This folder already matches that state. Nothing would change."
    IDS_BTN_RESTORE     "Restore"
    IDS_RESTORE_RUNNING "Restoring..."
    IDS_S7_RESTORED     "Restored to %s."
END

// Polish reuses the legacy InstallationForm.pl.resx terms, so returning users see familiar words.
LANGUAGE LANG_POLISH, SUBLANG_DEFAULT
STRINGTABLE
BEGIN
    IDS_CONNECTING      "Łączenie..."
    IDS_DOWNLOADING     "Aktualnie pobieram: %s"
    IDS_VERIFYING       "Weryfikacja..."
    IDS_BACKUP          "Zapisywanie kopii zapasowej"
    IDS_INSTALLING      "Aktualnie instaluję: %s"
    IDS_DONE            "Gotowe"
    IDS_READY           "Gotowy."
    IDS_ALREADY_RUNNING "Instalator Pacenotes jest już uruchomiony.\n\nZamknij drugie okno i spróbuj ponownie. Dwie kopie nadpisywałyby sobie nawzajem pobrane pliki i zapis instalacji."
    IDS_CRASH           "Coś poszło nie tak i instalator musi się zamknąć.\r\n\r\nSzczegóły zapisano w pliku:\r\n%s\r\n\r\nFolder gry nie został w połowie zainstalowany: to, co już zapisano, też jest tam odnotowane.\r\n\r\nPokazać ten plik?"
    IDS_CRASH_NOFILE    "Coś poszło nie tak i instalator musi się zamknąć. Nie udało się zapisać dziennika, więc to jedyna kopia informacji o błędzie:"
    IDS_APP_TITLE       "Instalator Pacenotes"

    IDS_BTN_CONTINUE    "Kontynuuj"
    IDS_BTN_ACCEPT      "AKCEPTUJ"
    IDS_BTN_NEXT        "Dalej"
    IDS_BTN_DOWNLOAD    "Pobierz"
    IDS_BTN_INSTALL     "Instaluj"
    IDS_BTN_FINISH      "Zakończ"
    IDS_BTN_BROWSE      "Przeglądaj..."
