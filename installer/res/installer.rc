// installer.rc — wizard pages, strings, manifest, icon, version.
// Layout follows installer/DESIGN.md rev. 2 (seven-scene wizard).
// Control IDs must match src/wizard.rs. Polish strings below are UTF-8; keep
// this pragma or they will mojibake.
#pragma code_page(65001)
#include <windows.h>
#include <prsht.h>

// Common Controls v6 + DPI awareness manifest
1 RT_MANIFEST "app.manifest"

// ---- Application icon ----
// Lowest-numbered icon resource is what Explorer/the taskbar show, so keep
// IDI_APPICON at 1.
#define IDI_APPICON 1
IDI_APPICON ICON "../../rbr.ico"

// ---- Version info ----
// Keep FILEVERSION/PRODUCTVERSION in sync with [package] version in
// Cargo.toml — tests/Test-VersionSync.ps1 enforces it and the CD workflows
// read that value to tag releases.
VS_VERSION_INFO VERSIONINFO
FILEVERSION     0,1,0,0
PRODUCTVERSION  0,1,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"   // US English, Unicode
        BEGIN
            VALUE "CompanyName",      "Pacenotes"
            VALUE "FileDescription",  "Pacenotes Installer for Richard Burns Rally"
            VALUE "FileVersion",      "0.1.0.0"
            VALUE "InternalName",     "pacenotes-installer"
            VALUE "LegalCopyright",   "MIT"
            VALUE "OriginalFilename", "pacenotes-installer.exe"
            VALUE "ProductName",      "Pacenotes Installer"
            VALUE "ProductVersion",   "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

// ============================================================
// Control IDs — one block per scene, so a whole page can be addressed.
// ============================================================
#define IDC_SCENE_TITLE     299

#define IDD_S1_LANGUAGE     300
#define IDC_S1_PROMPT       301
#define IDC_S1_COMBO        302
#define IDC_S1_NOTE         303

#define IDD_S2_MOTD         310
#define IDC_S2_MOTD         311
#define IDC_S2_SECRET_LABEL 312
#define IDC_S2_SECRET       313
#define IDC_S2_STATUS       314

#define IDD_S3_FOLDER       320
#define IDC_S3_PATH_LABEL   321
#define IDC_S3_PATH         322
#define IDC_S3_BROWSE       323
#define IDC_S3_GAME_LABEL   324
#define IDC_S3_GAME         325

// ============================================================
// String IDs
// ============================================================
// Worker / status (1-19)
#define IDS_CONNECTING          1
#define IDS_DOWNLOADING         2
#define IDS_VERIFYING           3
#define IDS_BACKUP              4
#define IDS_INSTALLING          5
#define IDS_DONE                6
#define IDS_READY               9
#define IDS_NOT_IMPL           10
#define IDS_APP_TITLE          20

// Per-scene primary button labels + shared chrome (30-49)
#define IDS_BTN_CONTINUE       30
#define IDS_BTN_ACCEPT         31
#define IDS_BTN_NEXT           32
#define IDS_BTN_DOWNLOAD       33
#define IDS_BTN_INSTALL        34
#define IDS_BTN_FINISH         35
#define IDS_BTN_BROWSE         36
#define IDS_BTN_BACK           38
#define IDS_BTN_CANCEL         39
#define IDS_CANCEL_CONFIRM     37

// Scene 1 — Language (50-59)
#define IDS_S1_TITLE           50
#define IDS_S1_PROMPT          51
#define IDS_S1_RESTART         52

// Scene 2 — Message of the day (60-69)
#define IDS_S2_TITLE           60
#define IDS_S2_SECRET          61
#define IDS_S2_CHECKING        62
#define IDS_S2_ONLINE          63
#define IDS_S2_OFFLINE         64
#define IDS_S2_OFFLINE_MOTD    65
#define IDS_S2_BADSECRET       66

// Scene 3 — Game folder (70-79)
#define IDS_S3_TITLE           70
#define IDS_S3_PATH            71
#define IDS_S3_GAME            72
#define IDS_S3_DETECTING       73
#define IDS_S3_NOGAME          74

// ============================================================
// Wizard pages — language-neutral templates.
// Text here is an English fallback only; wizard.rs sets every caption from
// the string table at WM_INITDIALOG, so the shipped UI follows the language
// chosen on scene 1.
//
// A PropertySheet sizes itself to its LARGEST page, so every page shares one
// size. Scene 1 is therefore not the "small window" DESIGN.md pictures; see
// installer/TASKS.md I2b for that recorded deviation.
// ============================================================
LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

IDD_S1_LANGUAGE DIALOGEX 0, 0, 290, 150
STYLE DS_SHELLFONT | DS_3DLOOK | DS_CONTROL | WS_CHILD | WS_DISABLED
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "", IDC_SCENE_TITLE, 14, 8, 262, 12
    LTEXT           "Select language:", IDC_S1_PROMPT, 14, 30, 260, 10
    COMBOBOX        IDC_S1_COMBO, 14, 44, 180, 90,
                    CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    LTEXT           "Restart the application to change language later.",
                    IDC_S1_NOTE, 14, 66, 262, 20
END

IDD_S2_MOTD DIALOGEX 0, 0, 290, 150
STYLE DS_SHELLFONT | DS_3DLOOK | DS_CONTROL | WS_CHILD | WS_DISABLED
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "", IDC_SCENE_TITLE, 14, 8, 262, 12
    EDITTEXT        IDC_S2_MOTD, 14, 24, 262, 68,
                    ES_MULTILINE | ES_READONLY | WS_VSCROLL | NOT WS_TABSTOP
    LTEXT           "Secret:", IDC_S2_SECRET_LABEL, 14, 100, 60, 9
    EDITTEXT        IDC_S2_SECRET, 78, 98, 198, 13, ES_AUTOHSCROLL | ES_PASSWORD
    LTEXT           "", IDC_S2_STATUS, 14, 122, 262, 10
END

IDD_S3_FOLDER DIALOGEX 0, 0, 290, 150
STYLE DS_SHELLFONT | DS_3DLOOK | DS_CONTROL | WS_CHILD | WS_DISABLED
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "", IDC_SCENE_TITLE, 14, 8, 262, 12
    LTEXT           "Game folder:", IDC_S3_PATH_LABEL, 14, 28, 262, 9
    EDITTEXT        IDC_S3_PATH, 14, 40, 204, 13, ES_AUTOHSCROLL
    PUSHBUTTON      "Browse...", IDC_S3_BROWSE, 224, 39, 52, 15
    LTEXT           "Game:", IDC_S3_GAME_LABEL, 14, 66, 262, 9
    COMBOBOX        IDC_S3_GAME, 14, 78, 204, 90,
                    CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
END

// ============================================================
// Strings. One STRINGTABLE per language; LoadStringW resolves against the
// thread UI language, which i18n::set_language sets via SetThreadUILanguage.
// Every id MUST exist in every table — there is no neutral fallback table.
// Game names are proper nouns and live in gamedir.rs, untranslated.
// ============================================================
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
STRINGTABLE
BEGIN
    IDS_CONNECTING      "Connecting..."
    IDS_DOWNLOADING     "Downloading: %s"
    IDS_VERIFYING       "Verifying..."
    IDS_BACKUP          "Writing backup"
    IDS_INSTALLING      "Installing: %s"
    IDS_DONE            "Done"
    IDS_READY           "Ready."
    IDS_NOT_IMPL        "Not implemented yet."
    IDS_APP_TITLE       "Pacenotes Installer"

    IDS_BTN_CONTINUE    "Continue"
    IDS_BTN_ACCEPT      "ACCEPT"
    IDS_BTN_NEXT        "Next"
    IDS_BTN_DOWNLOAD    "Download"
    IDS_BTN_INSTALL     "Install"
    IDS_BTN_FINISH      "Finish"
    IDS_BTN_BROWSE      "Browse..."
    IDS_BTN_BACK        "< Back"
    IDS_BTN_CANCEL      "Cancel"
    IDS_CANCEL_CONFIRM  "Stop the installer and close this window?"

    IDS_S1_TITLE        "Language"
    IDS_S1_PROMPT       "Select the language for this installation:"
    IDS_S1_RESTART      "The choice applies to the whole run. Restart the installer to change it."

    IDS_S2_TITLE        "Message of the day"
    IDS_S2_SECRET       "Secret:"
    IDS_S2_CHECKING     "Server status: Checking..."
    IDS_S2_ONLINE       "Server status: Online"
    IDS_S2_OFFLINE      "Server status: Offline"
    IDS_S2_OFFLINE_MOTD "The server could not be reached.\r\n\r\nYou can continue: only content already downloaded to this computer will be available."
    IDS_S2_BADSECRET    "The server did not accept that secret.\n\nClear the field to continue without private content, or correct it and try again."

    IDS_S3_TITLE        "Game folder"
    IDS_S3_PATH         "Folder the game is installed in:"
    IDS_S3_GAME         "Detected game:"
    IDS_S3_DETECTING    "(Detecting)"
    IDS_S3_NOGAME       "No supported game was found in that folder.\n\nChoose the folder that contains the game's own executable."
END

// Polish wording reuses the legacy InstallationForm.pl.resx terms where the
// original had an equivalent control, so returning users see familiar words.
LANGUAGE LANG_POLISH, SUBLANG_DEFAULT
STRINGTABLE
BEGIN
    IDS_CONNECTING      "Łączenie..."
    IDS_DOWNLOADING     "Aktualnie pobieram: %s"
    IDS_VERIFYING       "Weryfikacja..."
    IDS_BACKUP          "Zapisywanie kopii zapasowej"
    IDS_INSTALLING      "Aktualnie instaluję: %s"
    IDS_DONE            "Gotowe"
    IDS_READY           "Gotowy."
    IDS_NOT_IMPL        "Jeszcze niezaimplementowane."
    IDS_APP_TITLE       "Instalator Pacenotes"

    IDS_BTN_CONTINUE    "Kontynuuj"
    IDS_BTN_ACCEPT      "AKCEPTUJ"
    IDS_BTN_NEXT        "Dalej"
    IDS_BTN_DOWNLOAD    "Pobierz"
    IDS_BTN_INSTALL     "Instaluj"
    IDS_BTN_FINISH      "Zakończ"
    IDS_BTN_BROWSE      "Przeglądaj..."
    IDS_BTN_BACK        "< Wstecz"
    IDS_BTN_CANCEL      "Anuluj"
    IDS_CANCEL_CONFIRM  "Zatrzymać instalator i zamknąć to okno?"

    IDS_S1_TITLE        "Język"
    IDS_S1_PROMPT       "Wybierz język tej instalacji:"
    IDS_S1_RESTART      "Wybór obowiązuje przez cały przebieg. Aby go zmienić, uruchom instalator ponownie."

    IDS_S2_TITLE        "Wiadomość dnia"
    IDS_S2_SECRET       "Klucz dostępu:"
    IDS_S2_CHECKING     "Stan serwera: Sprawdzanie..."
    IDS_S2_ONLINE       "Stan serwera: Online"
    IDS_S2_OFFLINE      "Stan serwera: Offline"
    IDS_S2_OFFLINE_MOTD "Nie udało się połączyć z serwerem.\r\n\r\nMożesz kontynuować: dostępna będzie wyłącznie zawartość wcześniej pobrana na ten komputer."
    IDS_S2_BADSECRET    "Serwer nie zaakceptował tego klucza.\n\nWyczyść pole, aby kontynuować bez zawartości prywatnej, albo popraw klucz i spróbuj ponownie."

    IDS_S3_TITLE        "Folder gry"
    IDS_S3_PATH         "Folder, w którym zainstalowana jest gra:"
    IDS_S3_GAME         "Wykryta gra:"
    IDS_S3_DETECTING    "(Wykrywanie)"
    IDS_S3_NOGAME       "W tym folderze nie znaleziono obsługiwanej gry.\n\nWskaż folder zawierający plik wykonywalny gry."
END
