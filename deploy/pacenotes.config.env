##___PACENOTES SERVER___##
## Copy to ~/.config/containers/systemd/pacenotes.config.env and edit.
## Read by BOTH sections of pacenotes.container:
##  - [Service] uses the build variables below (git clone + podman build)
##  - [Container] passes the PACENOTES_* / RUST_LOG ones into the server

## --- deployment (where the code comes from) ---
BRANCH_TO_BUILD=master
APP_SOURCE_DIR="/tmp/pacenotes/source"
GIT_REPO_URL="ssh://git@git.example.com:22/user/coDriver_Installer.git"
IMAGE_NAME="localhost/pacenotes-server:latest"

## --- server configuration ---
## Must be 0.0.0.0: Caddy cannot reach a loopback bind inside the container.
PACENOTES_LISTEN=0.0.0.0:8080

## Data root. The container always sees /data; the host path is set by the
## Volume= line in pacenotes.container, not here.
##   /data/<game>/packages/<directory>/<name>.zip   packages
##   /data/motd/<lang>.txt                          message of the day
##   /data/manifest.json                            generated, do not edit
PACENOTES_DATA_DIR=/data

## Credentials (libSQL); a libsql://… URL moves auth to Turso and needs PACENOTES_DB_AUTH_TOKEN.
PACENOTES_DB_URL=file:/data/auth.db

## 1 regenerates manifest.json on every start; 0 leaves it to you.
PACENOTES_GEN_ON_START=1

## trace|debug|info|warn|error. Access keys are never logged at any level.
RUST_LOG=info

## Proxies (IPs or CIDRs, comma-separated) whose X-Forwarded-For counts when rate-limiting reports; empty ignores it.
PACENOTES_TRUSTED_PROXIES=10.0.0.0/24
