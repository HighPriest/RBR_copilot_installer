# Pacenotes package/auth server — Podman Quadlet.
#
# Runs the image tagged localhost/pacenotes-server:current. Nothing here
# builds or pulls: the release workflow builds the image in CI and pushes it
# to GHCR, and deploy/pacenotes-update pulls one exact version, moves
# `:current` onto it (keeping the old one as `:previous`) and restarts this
# unit — rolling back by itself if the new container never turns healthy.
# A restart is therefore just a restart, and works with the registry down.
#
# Install (see deploy/README.md for the full walkthrough):
#   cp deploy/pacenotes.container deploy/pacenotes.config.env \
#      ~/.config/containers/systemd/
#   install -m 755 deploy/pacenotes-update ~/bin/
#   ~/.local/bin/pacenotes-update X.Y.Z        # the first time, by hand

[Unit]
Description=Pacenotes package + auth server - Quadlet
# Caddy fronts it, but it does not have to be up for this to serve.
After=network-online.target
StartLimitIntervalSec=1h
StartLimitBurst=3

[Container]
ContainerName=pacenotes
# A LOCAL tag only pacenotes-update moves. Never a registry reference: a
# restart must not change what runs, and no AutoUpdate=, because
# `podman auto-update` updates every container on the host that has it.
Image=localhost/pacenotes-server:current
Pull=never

EnvironmentFile=pacenotes.config.env

# Back this up: auth.db is the one file here that cannot be regenerated.
Volume=%h/pacenotes/data:/data:Z

Network=internal.network

# No PublishPort: only Caddy, which terminates TLS, reaches `pacenotes:8080`.
# pacenotes-update waits on this healthcheck before it calls a deploy good.
HealthCmd=curl --fail --silent http://localhost:8080/health
HealthInterval=1m
HealthTimeout=10s
HealthRetries=3

# Longer than the server's 20 s drain, which podman's default 10 s would cut short.
StopTimeout=30

[Service]
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target network-online.target
