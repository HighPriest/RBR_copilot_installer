# S1 — the server: how one download request is answered.
# Sources: server/src/routes.rs, server/src/auth/, server/src/store/.

vars: {
  d2-config: {
    layout-engine: dagre
    theme-id: 0
    pad: 24
  }
}

direction: down

title: |md
  # S1 — Server: how one download request is answered
  `GET /download/{game}/{directory}/{*name}` — colour names who decides:
  the handler, the access decision, the store. Every oval is a final answer.
| {near: top-center}

classes: {
  handler: {style: {fill: "#EEF7F2"; stroke: "#3D8A6A"}}
  auth: {style: {fill: "#F6F0FB"; stroke: "#8E5BB5"}}
  store: {style: {fill: "#EEF3FB"; stroke: "#3F6FB5"}}
  decision: {shape: diamond; style: {fill: "#FFF8E5"; stroke: "#C9A33B"}}
  answer: {shape: oval; style: {fill: "#FFFFFF"; stroke: "#555555"}}
  ok: {shape: oval; style: {fill: "#E9F7EE"; stroke: "#2E8B57"}}
  dot: {shape: circle; width: 24; height: 24; style: {fill: "#333333"; stroke: "#333333"}}
}

start: "" {class: dot}
ids: "valid game,\ndirectory\nand name?" {class: decision}
public: "the public\ndirectory?" {class: decision}
header: "Bearer header well formed?\nGarbage costs no query" {class: auth}
load: "load_token(): tokens LEFT JOIN\ngrants, decoded fail-closed" {class: auth}
decide: "decide()" {class: decision}
lookup: "Manifest lookup: only a hit\nyields a path on disk" {class: store}
hit: "in the\nmanifest?" {class: decision}
size: "Stat the file: size\nequals the manifest's?" {class: store}
fresh: "If-None-Match\nequals the\nsha256?" {class: decision}
stream: "Stream it: ETag, Content-Length,\nContent-Disposition naming the leaf" {class: handler}

r404a: "404 — nothing\ncould exist" {class: answer}
r401: "401 — no live key, whether\nor not the package exists" {class: answer}
r404b: "404 — no grant, or no such\npackage: the same answer" {class: answer}
r503: "503 — being copied,\nor a stale manifest" {class: answer}
r304: "304 — not modified" {class: answer}
r200: "200 — the zip streams" {class: ok}

start -> ids
ids -> r404a: "no"
ids -> public: "yes"
public -> lookup: "yes: no key needed"
public -> header: "no"
header -> load -> decide
decide -> r401: "unauthorized"
decide -> r404b: "hidden"
decide -> lookup: "allow"
lookup -> hit
hit -> r404b: "no"
hit -> size: "yes"
size -> r503: "no"
size -> fresh: "yes"
fresh -> r304: "yes"
fresh -> stream: "no"
stream -> r200
