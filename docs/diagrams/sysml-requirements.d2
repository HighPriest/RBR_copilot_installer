# SY-3 — SysML requirement diagram: each requirement, the test case that
# verifies it, and the block that satisfies it — one row each, so no line
# crosses another.

vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 0
    pad: 24
  }
}

title: |md
  # SY-3 — SysML requirements
  Each row: the test case that «verify»s the requirement, and the block that «satisfy»s it.
| {near: top-center}

classes: {
  req: {style: {fill: "#FFFDF5"; stroke: "#C9A33B"}}
  block: {style: {fill: "#FFFFFF"; stroke: "#3F6FB5"}}
  test: {shape: page; style: {fill: "#EEF7F2"; stroke: "#3D8A6A"}}
  heading: {shape: text; style: {font-size: 18; bold: true}}
  verify: {style: {stroke: "#3D8A6A"; stroke-dash: 4}}
  satisfy: {style: {stroke: "#3F6FB5"}}
}

grid-rows: 13
grid-columns: 3
horizontal-gap: 90
vertical-gap: 18

h_test: "«test case»" {class: heading}
h_req: "«requirement»" {class: heading}
h_block: "«block»" {class: heading}

t_size: "installer/tests/\nTest-BinarySize.ps1" {class: test}
r_size: "R-SIZE\nthe .exe stays under 700 kB and\nimports only DLLs Windows ships" {class: req}
b_size: "Installer" {class: block}

t_tls: "installer/tests/\nTest-PublicEndpoint.ps1" {class: test}
r_tls: "R-TLS\nHTTPS through WinHTTP and Schannel;\nno TLS, async or GUI crate" {class: req}
b_tls: "Installer / http" {class: block}

t_redirect: "installer/tests/\nTest-Redirects.ps1" {class: test}
r_redirect: "R-REDIRECT\nredirects followed by the installer;\nthe key never leaves its origin" {class: req}
b_redirect: "Installer / http" {class: block}

t_overlay: "installer/tests/\napplying_a_selection.rs" {class: test}
r_overlay: "R-OVERLAY\na package is a game-root overlay;\nits content is never interpreted" {class: req}
b_overlay: "Installer / engine" {class: block}

t_local: "installer/src/cache/tests.rs,\ninstaller/src/ledger/tests.rs" {class: test}
r_local: "R-LOCAL\nnothing is written outside\nthe game folder" {class: req}
b_local: "Installer / cache + ledger" {class: block}

t_offline: "installer/tests/\nrestoring_a_game_folder.rs" {class: test}
r_offline: "R-OFFLINE\ninstall and restore work\nfrom the cache" {class: req}
b_offline: "Installer / engine + restore" {class: block}

t_schema: "installer/src/\nschema/tests.rs" {class: test}
r_schema: "R-SCHEMA\nan unknown schema hash blocks\ndownloading for that game only" {class: req}
b_schema: "Installer / schema" {class: block}

t_auth: "server/src/auth/\naccess_decision.rs" {class: test}
r_auth: "R-AUTH\nbearer keys stored as sha256,\ngrants per directory, no tiers" {class: req}
b_auth: "Server / auth" {class: block}

t_enum: "server/tests/\naccess_matrix.rs" {class: test}
r_enum: "R-ENUM\nstatuses never enumerate;\nthere is no 403" {class: req}
b_enum: "Server / routes" {class: block}

t_path: "server/tests/\npackage_download.rs" {class: test}
r_path: "R-PATH\nURL parts are lookup keys,\nnever paths" {class: req}
b_path: "Server / store" {class: block}

t_pure: "server/tests/\npublishing.rs" {class: test}
r_pure: "R-PURE\nthe manifest is a pure function\nof zips, sidecars and schemas" {class: req}
b_pure: "Server / store" {class: block}

t_report: "server/tests/\nconflict_reports.rs" {class: test}
r_report: "R-REPORT\nreports are unauthenticated, capped,\nvalidated and rate limited" {class: req}
b_report: "Server / reports" {class: block}

t_size -> r_size: "«verify»" {class: verify}
b_size -> r_size: "«satisfy»" {class: satisfy}
t_tls -> r_tls: "«verify»" {class: verify}
b_tls -> r_tls: "«satisfy»" {class: satisfy}
t_redirect -> r_redirect: "«verify»" {class: verify}
b_redirect -> r_redirect: "«satisfy»" {class: satisfy}
t_overlay -> r_overlay: "«verify»" {class: verify}
b_overlay -> r_overlay: "«satisfy»" {class: satisfy}
t_local -> r_local: "«verify»" {class: verify}
b_local -> r_local: "«satisfy»" {class: satisfy}
t_offline -> r_offline: "«verify»" {class: verify}
b_offline -> r_offline: "«satisfy»" {class: satisfy}
t_schema -> r_schema: "«verify»" {class: verify}
b_schema -> r_schema: "«satisfy»" {class: satisfy}
t_auth -> r_auth: "«verify»" {class: verify}
b_auth -> r_auth: "«satisfy»" {class: satisfy}
t_enum -> r_enum: "«verify»" {class: verify}
b_enum -> r_enum: "«satisfy»" {class: satisfy}
t_path -> r_path: "«verify»" {class: verify}
b_path -> r_path: "«satisfy»" {class: satisfy}
t_pure -> r_pure: "«verify»" {class: verify}
b_pure -> r_pure: "«satisfy»" {class: satisfy}
t_report -> r_report: "«verify»" {class: verify}
b_report -> r_report: "«satisfy»" {class: satisfy}
