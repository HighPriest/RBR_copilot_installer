# SY-2 — SysML internal block diagram: deployment and interfaces.
# Sources: deploy/ (Containerfile, Quadlet, Caddy block), installer/src/http/, server/src/routes.rs.

vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 0
    pad: 24
  }
}

direction: down

title: |md
  # SY-2 — SysML: deployment
  The parts as they are wired, and what each connection carries.
| {near: top-center}

classes: {
  part: {style: {fill: "#FFFFFF"; stroke: "#3F6FB5"}}
  store: {shape: cylinder; style: {fill: "#F2F4F7"; stroke: "#77808D"}}
  actor: {shape: person; style: {fill: "#FBF0E4"; stroke: "#C08A55"}}
}

player: "Player\n«actor»" {class: actor}

pc: "Player's Windows PC" {
  installer: "«part» Installer\nWindows .exe;\nWinHTTP over Schannel" {class: part}
  game: "«part» Game Installation\nfile system" {class: store}
  installer -> game: "the overlay; cache, ledger,\nrestore points, logs\nunder .pacenotes/"
}

host: "Server host" {
  caddy: "«part» Caddy\nreverse proxy;\nTLS ends here" {class: part}
  server: "«part» Server\nPodman container" {class: part}
  catalogue: "«part» Package Catalogue\n./data" {class: store}
  authdb: "«part» Auth DB\nlibSQL" {class: store}

  caddy -> server: "plain HTTP :8080"
  server -> catalogue: "manifest.json,\nzip streams"
  server -> authdb: "tokens LEFT JOIN grants"
}

operator: "Operator\n«actor»" {class: actor}

player -> pc.installer: "choices"
pc.installer -> host.caddy: "HTTPS: /packages, /download,\n/motd, /whoami,\nPOST /report/conflict"
operator -> host.catalogue: "copy a zip + sidecar;\nmanifest gen"
operator -> host.authdb: "token mint,\ngrant, revoke"
