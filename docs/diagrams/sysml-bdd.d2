# SY-1 — SysML block definition diagram: the system and its blocks.
# The responsibilities and constraints in full are in docs/src/architecture/system.md.

vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 0
    pad: 24
  }
}

direction: down

title: |md
  # SY-1 — SysML block definition
  A filled diamond is composition: the whole owns the part.
  A dashed arrow is a compile-time dependency.
| {near: top-center}

classes: {
  block: {shape: rectangle; style: {fill: "#FFFFFF"; stroke: "#3F6FB5"}}
  external: {shape: rectangle; style: {fill: "#F2F4F7"; stroke: "#77808D"}}
  uses: {style: {stroke-dash: 4; stroke: "#3F6FB5"}}
}

system: "«block»\nPacenotes System" {class: block}

installer: |md
  «block» **Installer**

  - Windows GUI: nine pages,
    three routes, one worker
  - .exe under 700 kB
  - no tokio, reqwest, rustls,
    hyper or GUI crate
| {class: block}

protocol: |md
  «block» **Shared Protocol**

  - the wire types
  - serde only: no I/O,
    no async, no HTTP
| {class: block}

server: |md
  «block» **Package Server**

  - routes, auth, store,
    reports, admin CLI
  - one static binary;
    TLS is the proxy's job
| {class: block}

catalogue: |md
  «block» **Package Catalogue**

  - zips, sidecars, schemas
  - manifest.json, MOTD,
    conflict reports
| {class: block}

authdb: |md
  «block» **Auth Database**

  - libSQL: keys and grants
  - raw keys never stored
| {class: block}

game: |md
  «block» **Game Installation**

  - external: the folder a run
    targets; .pacenotes holds
    every trace of the installer
| {class: external}

system <-> installer: {source-arrowhead: {shape: diamond; style.filled: true}}
system <-> protocol: {source-arrowhead: {shape: diamond; style.filled: true}}
system <-> server: {source-arrowhead: {shape: diamond; style.filled: true}}
system <-> catalogue: {source-arrowhead: {shape: diamond; style.filled: true}}
system <-> authdb: {source-arrowhead: {shape: diamond; style.filled: true}}
installer -> protocol: "«use»" {class: uses}
server -> protocol: "«use»" {class: uses}
installer -> game: "writes only here"
server -> catalogue: "reads; publishes\nmanifest.json"
server -> authdb: "SQL"
