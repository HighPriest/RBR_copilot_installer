# ER-2 — the installer: what a run leaves inside <game folder>\.pacenotes.
# Sources: installer/src/cache/, installer/src/ledger/, installer/src/restore/, installer/src/runlog/.
# The meaning of each column is in docs/src/architecture/data-model.md.

vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 0
    pad: 24
  }
}

direction: down

title: |md
  # ER-2 — Installer: the game folder's .pacenotes
  The package identity (game/directory/name) and its sha256 travel from
  ER-1 into the cache, and from the cache into the ledger.
| {near: top-center}

classes: {
  local: {style: {stroke: "#3F6FB5"; fill: "#EEF3FB"}}
  disk: {style: {stroke: "#77808D"; fill: "#F2F4F7"}}
  logical: {style: {stroke-dash: 4}}
}

cache: "Download cache (cache/)" {
  class: local

  index: "CACHE_INDEX (cache.json)" {
    shape: sql_table
    version: INTEGER {constraint: primary_key}
    packages: "key → entry"
  }

  entry: CACHE_ENTRY {
    shape: sql_table
    key: "game/dir/name" {constraint: primary_key}
    sha256: TEXT {constraint: foreign_key}
    version: TEXT
    size: INTEGER
    updated_at: INTEGER
    display_name: TEXT NULL
    exclusive_group: TEXT NULL
    requires: "[dir/name]"
  }

  payload: "CACHE_PAYLOAD (<sha256>.zip)" {
    shape: sql_table
    sha256: TEXT {constraint: primary_key}
  }

  index -> entry: "1 : 0..*"
  entry -> payload: "0..* : 1"
}

ledger: "Install ledger (installed.json)" {
  class: local

  document: LEDGER {
    shape: sql_table
    version: INTEGER {constraint: primary_key}
    packages: "key → entry"
  }

  entry: LEDGER_ENTRY {
    shape: sql_table
    key: "game/dir/name" {constraint: primary_key}
    sha256: TEXT
    version: TEXT
    exclusive_group: TEXT NULL
    state: "installing / installed"
  }

  file: LEDGER_FILE {
    shape: sql_table
    entry: key {constraint: [primary_key; foreign_key]}
    path_folded: TEXT {constraint: primary_key}
    path: "as written"
    sha256: "what WE wrote"
    prior: "absent / identical / backup"
  }

  document -> entry: "1 : 0..*"
  entry -> file: "1 : 1..*"
}

restore: "Restore points (restore/<stamp>/)" {
  class: disk

  point: RESTORE_POINT {
    shape: sql_table
    name: "UTC stamp" {constraint: primary_key}
    ledger_json: "ledger before the run"
    files: "originals replaced"
  }

  saved: SAVED_FILE {
    shape: sql_table
    point: TEXT {constraint: [primary_key; foreign_key]}
    path: TEXT {constraint: primary_key}
    bytes: original
  }

  snapshot: LEDGER_SNAPSHOT {
    shape: sql_table
    class: logical
    point: TEXT {constraint: [primary_key; foreign_key]}
    packages: "frozen entries"
  }

  point -> saved: "1 : 0..*"
  point -> snapshot: "ledger.json" {class: logical}
}

logs: "Run logs (logs/)" {
  class: disk

  log: RUN_LOG {
    shape: sql_table
    stamp: "install-<stamp>.log" {constraint: primary_key}
    header: "build, start, server, Windows"
    lines: "timed in UTC"
  }
}

cache.entry -> ledger.entry: "installed as" {class: logical}
ledger.file -> restore.point: "prior = backup" {class: logical}
