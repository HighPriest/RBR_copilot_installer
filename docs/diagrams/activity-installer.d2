# A1 — the installer: one run, from launch to the summary.
# Sources: installer/src/wizard/ (scene/*.rs), installer/src/worker/.

direction: down

title: |md
  # A1 — Installer: one run, three routes
  Colour names who acts: the wizard on the UI thread, the one worker thread, the disk. Scene 3's route is the only branch that skips pages.
| {near: top-center}

classes: {
  ui: {style: {fill: "#EAF1FA"; stroke: "#7FA0C6"}}
  worker: {style: {fill: "#F1EAF9"; stroke: "#9A7FC0"}}
  disk: {style: {fill: "#EEF1F5"; stroke: "#8A97A8"}}
  decision: {shape: diamond; style: {fill: "#FFF8E5"; stroke: "#C9A33B"}}
  stop: {shape: oval; style: {fill: "#FFFFFF"; stroke: "#555555"}}
  dot: {shape: circle; width: 24; height: 24; style: {fill: "#333333"; stroke: "#333333"}}
}

start: "" {class: dot}
launch: "Launch: one instance per user, common controls, the Windows UI language" {class: ui}
language: "Scene 1 — the UI language (default: Windows')" {class: ui}
motd: "Scene 2 — message of the day, with its own line breaks; optional access key" {class: ui}
key: "key typed?" {class: decision}
whoami: "GET /whoami on the worker: 200 live, 401 wrong, expired or revoked" {class: worker}
folder: "Scene 3 — the folder; the game is detected from its marker .exe. Not writable: offer to restart as administrator" {class: ui}
route: "route?" {class: decision}

start -> launch -> language -> motd -> key
key -> whoami: "yes"
whoami -> motd: "401: stay"
whoami -> folder: "live, or the server cannot be asked"
key -> folder: "no (anonymous)"
folder -> route

# Download / Update
tree: "Scene 4 — tick what to HAVE: catalogue + cache + ledger, every row expanded" {class: ui}
ticked: "a tick in every choice category shown?" {class: decision}
schema: "schema hash known to this build?" {class: decision}
blocked: "Download blocked — for THIS game only" {class: stop}
fetch: "Scene 4b — fetch what is not cached yet: sha256 verified as it streams, retried when a retry could help" {class: worker}
cached: "Cache gains <sha256>.zip + cache.json; the game folder is untouched" {class: disk}
arrived: "anything arrived?" {class: decision}

route -> tree: "Download / Update"
tree -> ticked
ticked -> tree: "no: name them"
ticked -> schema: "yes"
schema -> blocked: "no"
schema -> fetch: "yes"
fetch -> cached -> arrived

# Configure / Install
local: "Build the tree from cache + ledger: no server, no transfers" {class: ui}
route -> local: "Configure / Install"

# Both meet at the gate in front of scene 5.
ready: "every choice category has a ticked package in the cache?" {class: decision}
arrived -> ready: "yes"
local -> ready
ready -> folder: "no (Configure): download first"
ready -> tree: "no (Download): back, failures unticked"

configure: "Scene 5 — one pick per choice category, plus the optional extras" {class: ui}
answered: "every list answered?" {class: decision}
install: "Scene 6 — install on the worker (A2)" {class: worker}
summary: "Scene 7 — what changed, and where the log is" {class: ui}
end: "" {class: dot}

ready -> configure: "yes"
configure -> answered
answered -> configure: "no: name the lists"
answered -> install: "yes"
install -> summary -> end
arrived -> summary: "nothing: the reason is in the log"

# Restore / Uninstall
points: "Restore scene — points newest first, plus 'remove everything'" {class: ui}
preview: "Preview one: remove, put back, keep, unavailable" {class: ui}
empty: "plan empty?" {class: decision}
route -> points: "Restore / Uninstall"
points -> preview -> empty
empty -> points: "yes: nothing to do"
empty -> install: "no"

notes: |md
  - **Scene 4's ticks are what to HAVE; scene 5's picks are what to USE.** Downloading comes first, so the install page needs no network except to report a conflict.
  - **An unknown schema hash blocks downloading for that game only.** Reconfiguring, uninstalling and restoring keep working.
  - **Cancel** is the sheet's button, honoured before scene 6 and disabled there: from scene 6 on, every phase writes to the game folder.
| {shape: page; near: bottom-center}
