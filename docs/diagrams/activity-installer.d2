# A1 — the installer: one run, from launch to the summary.
# Sources: installer/src/wizard/ (scene/*.rs), installer/src/worker/.

vars: {
  d2-config: {
    layout-engine: dagre
    theme-id: 0
    pad: 24
  }
}

direction: down

title: |md
  # A1 — Installer: one run, three routes
  Colour names who acts: the wizard (UI thread), the worker thread, the disk.
| {near: top-center}

classes: {
  ui: {style: {fill: "#EAF1FA"; stroke: "#7FA0C6"}}
  worker: {style: {fill: "#F1EAF9"; stroke: "#9A7FC0"}}
  disk: {style: {fill: "#EEF1F5"; stroke: "#8A97A8"}}
  decision: {shape: diamond; style: {fill: "#FFF8E5"; stroke: "#C9A33B"}}
  stop: {shape: oval; style: {fill: "#FFFFFF"; stroke: "#555555"}}
  dot: {shape: circle; width: 24; height: 24; style: {fill: "#333333"; stroke: "#333333"}}
}

start: "" {class: dot}
launch: "Launch: one instance per user,\nthe Windows UI language" {class: ui}
language: "Scene 1 — the UI language" {class: ui}
motd: "Scene 2 — message of the day,\noptional access key" {class: ui}
key: "key\ntyped?" {class: decision}
whoami: "GET /whoami on the worker:\n200 live · 401 wrong, expired, revoked" {class: worker}
folder: "Scene 3 — the game folder; the game\nis detected from its marker .exe.\nNot writable: offer to restart as admin" {class: ui}
route: "route?" {class: decision}

start -> launch -> language -> motd -> key
key -> whoami: "yes"
whoami -> motd: "401: stay"
whoami -> folder: "live, or cannot ask"
key -> folder: "no"
folder -> route

# Download / Update
tree: "Scene 4 — tick what to HAVE:\ncatalogue + cache + ledger,\nevery row expanded" {class: ui}
ticked: "a tick in every\nchoice category?" {class: decision}
schema: "schema hash\nknown?" {class: decision}
blocked: "Download blocked,\nfor THIS game only" {class: stop}
fetch: "Scene 4b — fetch what is not cached:\nsha256 verified as it streams,\nretried when a retry could help" {class: worker}
cached: "The cache gains <sha256>.zip;\nthe game folder is untouched" {class: disk}
arrived: "anything\narrived?" {class: decision}

route -> tree: "Download / Update"
tree -> ticked
ticked -> tree: "no: name them"
ticked -> schema: "yes"
schema -> blocked: "no"
schema -> fetch: "yes"
fetch -> cached -> arrived

# Configure / Install
local: "Tree from cache + ledger:\nno server, no transfers" {class: ui}
route -> local: "Configure / Install"

# Both meet at the gate in front of scene 5.
ready: "every choice category\nhas a ticked package\nin the cache?" {class: decision}
arrived -> ready: "yes"
local -> ready
ready -> folder: "no (Configure):\ndownload first"
ready -> tree: "no (Download):\nfailures unticked"

configure: "Scene 5 — one pick per choice\ncategory, plus optional extras" {class: ui}
answered: "every list\nanswered?" {class: decision}
install: "Scene 6 — install\non the worker (A2)" {class: worker}
summary: "Scene 7 — what changed,\nand where the log is" {class: ui}
end: "" {class: dot}

ready -> configure: "yes"
configure -> answered
answered -> configure: "no: name the lists"
answered -> install: "yes"
install -> summary -> end
arrived -> summary: "nothing: the reason\nis in the log"

# Restore / Uninstall
points: "Restore scene — points newest\nfirst, plus 'remove everything'" {class: ui}
preview: "Preview one: remove,\nput back, keep, unavailable" {class: ui}
empty: "plan\nempty?" {class: decision}
route -> points: "Restore / Uninstall"
points -> preview -> empty
empty -> points: "yes: nothing to do"
empty -> install: "no"
