# S2 — the server: publishing with `manifest gen`.
# Sources: server/src/store/ (generation, sidecars, schemas), server/src/reports/.

vars: {
  d2-config: {
    layout-engine: dagre
    theme-id: 0
    pad: 24
  }
}

direction: down

title: |md
  # S2 — Server: publishing (manifest gen)
  Publishing is copying a zip into place and running one command,
  which is strict on purpose. A refusal writes nothing.
| {near: top-center}

classes: {
  cli: {style: {fill: "#EEF7F2"; stroke: "#3D8A6A"}}
  report: {style: {fill: "#FDF2E7"; stroke: "#C99A5B"}}
  decision: {shape: diamond; style: {fill: "#FFF8E5"; stroke: "#C9A33B"}}
  skip: {shape: oval; style: {fill: "#FFFFFF"; stroke: "#8A97A8"}}
  refuse: {shape: oval; style: {fill: "#FDECEC"; stroke: "#C0392B"}}
  dot: {shape: circle; width: 24; height: 24; style: {fill: "#333333"; stroke: "#333333"}}
}

start: "" {class: dot}
run: "pacenotes-server manifest gen\n--data ./data" {class: cli}
load: "Load the current manifest.json\n(only the two guards read it),\nthen walk <data>/" {class: cli}
folder: "reserved name,\nstray file, or\nno packages/?" {class: decision}
schema: "schema.toml\npresent and\nparses?" {class: decision}
hash: "Hash the schema's raw bytes; one\nthis build does not bundle is a\nwarning about a pending rollout" {class: cli}
category: "category\ndeclared?" {class: decision}
sidecar: "Read <name>.toml (an unknown key\nwithholds that package), then\nsha256, size and mtime" {class: cli}
requires: "Validate requires: the target exists\nin the same game; public never\nneeds protected content" {class: cli}
conflicts: "Summarise 30 days of conflict\nreports into per-pair warnings" {class: report}
vanish: "would a live\ngame vanish?" {class: decision}
lost: "would\nmetadata\nbe lost?" {class: decision}
write: "Write manifest.json atomically:\na temp file, then rename" {class: cli}
end: "Print every published package;\nexit 0, or 2 when something\nwas withheld" {class: cli}
done: "" {class: dot}

skip_folder: "skip, with\na warning" {class: skip}
nothing: "error: this game\npublishes nothing" {class: refuse}
skip_package: "skip the package,\nwith a warning" {class: skip}
refuse_vanish: "refuse, exit 1 —\nunless --accept-unpublish" {class: refuse}
refuse_lost: "refuse, exit 1 —\nunless --accept-metadata-loss" {class: refuse}

start -> run -> load -> folder
folder -> skip_folder: "yes"
folder -> schema: "no"
schema -> nothing: "no"
schema -> hash: "yes"
hash -> category
category -> skip_package: "no"
category -> sidecar: "yes"
sidecar -> requires -> conflicts -> vanish
vanish -> refuse_vanish: "yes"
vanish -> lost: "no"
lost -> refuse_lost: "yes"
lost -> write: "no"
write -> end -> done
