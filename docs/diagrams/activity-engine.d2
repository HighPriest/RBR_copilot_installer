# A2 — the installer: what scene 6 does inside the install engine.
# Sources: installer/src/engine/ (plan, preflight, execute), installer/src/install/.

vars: {
  d2-config: {
    layout-engine: dagre
    theme-id: 0
    pad: 24
  }
}

direction: down

title: |md
  # A2 — Installer: the install engine (scene 6)
  Colour names who acts: the worker calls, the engine decides,
  the ledger records ownership, the game folder changes.
| {near: top-center}

classes: {
  worker: {style: {fill: "#F1EAF9"; stroke: "#9A7FC0"}}
  engine: {style: {fill: "#FDF2E7"; stroke: "#C99A5B"}}
  ledger: {style: {fill: "#F3EEF9"; stroke: "#7D62A8"}}
  folder: {style: {fill: "#EEF1F5"; stroke: "#8A97A8"}}
  decision: {shape: diamond; style: {fill: "#FFF8E5"; stroke: "#C9A33B"}}
  stop: {shape: oval; style: {fill: "#FFFFFF"; stroke: "#555555"}}
  dot: {shape: circle; width: 24; height: 24; style: {fill: "#333333"; stroke: "#333333"}}
  each: {style: {fill: "#FFFFFF"; stroke: "#B5BFCC"; stroke-dash: 4; font-size: 15}}
}

start: "" {class: dot}
open: "Open the ledger and the cache;\nmap what is available" {class: worker}
plan: "plan(): uninstall what was dropped,\nsuperseded, half-written or changed;\ninstall the rest. requires is checked\nagainst the selection" {class: engine}
preflight: "Pre-flight, while nothing has moved:\npayload sha256, write probe, free space,\nthe game not running from this folder,\nevery file list" {class: engine}
pass: "plan and\npre-flight\npass?" {class: decision}
refused: "Refused before anything\nmoved: scene 7 says why" {class: stop}
overlaps: "overlaps(): files two selected\npackages both write" {class: engine}
point: "Open a restore point: <stamp>/\nholding the ledger as it is now" {class: ledger}

start -> open -> plan -> preflight -> pass
pass -> refused: "no"
pass -> overlaps: "yes"
overlaps -> point

remove: "for each package to remove — always first" {
  class: each
  owner: "Per file: another owner? still the bytes\nwe wrote? prior says delete, copy back, keep" {class: ledger}
  effect: "Deleted, the original copied back,\nor left alone and logged" {class: folder}
  forget: "The entry leaves the ledger;\nemptied folders are pruned" {class: ledger}
  owner -> effect -> forget
}

add: "for each package to install — its zip directory read once" {
  class: each
  prior: "Classify each file's prior:\nbackup (copied to the point),\nidentical (hashed, not rewritten), absent" {class: engine}
  ahead: "put(state = installing):\nthe write-ahead entry" {class: ledger}
  extract: "Extract: a temp file renamed\ninto place, one file at a time" {class: folder}
  done: "put(state = installed)\nwith each file's sha256" {class: ledger}
  prior -> ahead -> extract -> done
}

step: "the game's own step, once" {
  class: each
  edit: "RBR: set language and sounds\nin PaceNote.ini, nothing else" {class: engine}
  adopt: "record_configured(): adopt the edits,\nor the next uninstall reads them\nas someone else's" {class: ledger}
  edit -> adopt
}

report: "POST /report/conflict with the overlaps;\na failure is only a log line" {class: worker}
end: "" {class: dot}

point -> remove.owner
remove.forget -> add.prior
add.done -> step.edit
step.adopt -> report -> end
