# ER-1 — the server: authentication, catalogue and protocol documents.
# Sources: server/migrations/0001_init.sql, shared/src/, server/src/store/.
# The meaning of each column is in docs/src/architecture/data-model.md.

vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 0
    pad: 24
  }
}

direction: down

title: |md
  # ER-1 — Server: auth, catalogue, protocol
  A table is a database table, a file, or a document on the wire.
  A dashed line is a logical reference with no database constraint.
| {near: top-center}

classes: {
  auth: {style: {stroke: "#8E5BB5"; fill: "#F6F0FB"}}
  files: {style: {stroke: "#3D8A6A"; fill: "#EEF7F2"}}
  wire: {style: {stroke: "#3F6FB5"; fill: "#EEF3FB"}}
  logical: {style: {stroke-dash: 4}}
}

auth: "Auth database (libSQL, ./data/auth.db)" {
  class: auth
  direction: right

  tokens: TOKENS {
    shape: sql_table
    token_hash: "TEXT sha256" {constraint: primary_key}
    label_column: "TEXT NULL (label)"
    created_at: INTEGER
    expires_at: INTEGER NULL
    revoked: "INTEGER 0/1"
  }

  grants: GRANTS {
    shape: sql_table
    token_hash: TEXT {constraint: [primary_key; foreign_key]}
    directory: TEXT {constraint: primary_key}
  }

  grants.token_hash -> tokens.token_hash: "0..* : 1"
}

data: "Data root (./data, one folder per game)" {
  class: files
  direction: right

  game: GAME {
    shape: sql_table
    id: "TEXT [a-z0-9_-]+" {constraint: primary_key}
  }

  directory: ACCESS_DIRECTORY {
    shape: sql_table
    game: TEXT {constraint: [primary_key; foreign_key]}
    name: TEXT {constraint: primary_key}
  }

  package: PACKAGE {
    shape: sql_table
    game: TEXT {constraint: [primary_key; foreign_key]}
    directory: TEXT {constraint: [primary_key; foreign_key]}
    name: "TEXT path" {constraint: primary_key}
    version: TEXT
    size: INTEGER
    sha256: TEXT
    updated_at: INTEGER
    display_name: TEXT NULL
    exclusive_group: TEXT NULL
  }

  sidecar: "SIDECAR (<name>.toml)" {
    shape: sql_table
    package: "dir/name" {constraint: [primary_key; foreign_key]}
    version: TEXT NULL
    display_name: TEXT NULL
    description: TEXT NULL
    exclusive_group: TEXT NULL
    requires: "[dir/name]"
  }

  requires: PACKAGE_REQUIRES {
    shape: sql_table
    from: "game/dir/name" {constraint: [primary_key; foreign_key]}
    to: "dir/name" {constraint: primary_key}
  }

  schema: "SCHEMA (schema.toml)" {
    shape: sql_table
    game: TEXT {constraint: [primary_key; foreign_key]}
    sha256: "TEXT raw bytes"
  }

  category: SCHEMA_CATEGORY {
    shape: sql_table
    game: TEXT {constraint: [primary_key; foreign_key]}
    id: TEXT {constraint: primary_key}
    select: "one / any"
    install_root: "token"
  }

  motd: "MOTD (motd/<lang>.txt)" {
    shape: sql_table
    lang: "TEXT [a-z]{2,8}" {constraint: primary_key}
  }

  conflicts: "CONFLICT_RECORD (reports/*.jsonl)" {
    shape: sql_table
    line: "day + line" {constraint: primary_key}
    received_at: INTEGER
    game: TEXT {constraint: foreign_key}
    installer: TEXT
    conflicts: "file + packages[]"
  }

  game -> directory: "1 : 0..*"
  directory -> package: "1 : 0..*"
  sidecar -> package: "0..1 : 1"
  sidecar -> requires: "1 : 0..*"
  game -> schema: "1 : 1"
  schema -> category: "1 : 1..*"
}

wire: "Protocol documents (shared/, serde only)" {
  class: wire
  direction: right

  manifest: "MANIFEST (manifest.json, generated)" {
    shape: sql_table
    class: logical
    packages: "PackageInfo[]"
    schemas: "game → GameSchema"
  }

  key_status: "KeyStatus (GET /whoami)" {
    shape: sql_table
    expires_at: INTEGER NULL
  }

  report: "ConflictReport (POST /report/conflict)" {
    shape: sql_table
    game: TEXT
    installer: TEXT
    conflicts: "file + packages[]"
  }
}

auth.grants.directory -> data.directory.name: "logical FK" {class: logical}
wire.manifest -> data.package: "generated from" {class: logical}
wire.report -> data.conflicts: "one line each"
