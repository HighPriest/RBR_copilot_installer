# ER-1 — the server: authentication, catalogue and protocol documents.
# Sources: server/migrations/0001_init.sql, shared/src/, server/src/store/.

direction: right

title: |md
  # ER-1 — Server: authentication, catalogue and protocol documents
  Every table is a database table, a file, or a document on the wire. A dashed line is a logical reference with no database constraint; a dashed table is derived.
| {near: top-center}

classes: {
  auth: {style: {stroke: "#8E5BB5"; fill: "#F6F0FB"}}
  files: {style: {stroke: "#3D8A6A"; fill: "#EEF7F2"}}
  wire: {style: {stroke: "#3F6FB5"; fill: "#EEF3FB"}}
  logical: {style: {stroke-dash: 4}}
}

auth: "Auth database — libSQL, ./data/auth.db (--db-url)" {
  class: auth

  tokens: TOKENS {
    shape: sql_table
    token_hash: "TEXT — sha256(raw key)" {constraint: primary_key}
    label_column: "TEXT NULL — the column 'label'; D2 reserves the word"
    created_at: INTEGER
    expires_at: "INTEGER NULL — never"
    revoked: "INTEGER 0 or 1"
  }

  grants: GRANTS {
    shape: sql_table
    token_hash: TEXT {constraint: [primary_key; foreign_key]}
    directory: "TEXT — one directory a key may list and download" {constraint: primary_key}
  }

  grants.token_hash -> tokens.token_hash: "0..* : 1"
}

data: "Data root — ./data (--data), one folder per game" {
  class: files

  game: GAME {
    shape: sql_table
    id: "TEXT [a-z0-9_-]+ — data/<game>/" {constraint: primary_key}
  }

  directory: ACCESS_DIRECTORY {
    shape: sql_table
    game: TEXT {constraint: [primary_key; foreign_key]}
    name: "TEXT — packages/<directory>/, the AUTH unit" {constraint: primary_key}
  }

  package: PACKAGE {
    shape: sql_table
    game: TEXT {constraint: [primary_key; foreign_key]}
    directory: TEXT {constraint: [primary_key; foreign_key]}
    name: "TEXT — a path; its segments ARE the UI tree" {constraint: primary_key}
    version: TEXT
    size: INTEGER
    sha256: TEXT
    updated_at: "INTEGER unix s"
    display_name: TEXT NULL
    exclusive_group: TEXT NULL
  }

  sidecar: "SIDECAR — <name>.toml beside the zip" {
    shape: sql_table
    package: "directory / name" {constraint: [primary_key; foreign_key]}
    version: TEXT NULL
    display_name: TEXT NULL
    description: TEXT NULL
    exclusive_group: TEXT NULL
    requires: "[directory/name]"
  }

  requires: PACKAGE_REQUIRES {
    shape: sql_table
    from: "game/directory/name" {constraint: [primary_key; foreign_key]}
    to: "directory/name — the same game" {constraint: primary_key}
  }

  schema: "SCHEMA — <game>/schema.toml" {
    shape: sql_table
    game: TEXT {constraint: [primary_key; foreign_key]}
    sha256: "TEXT — of the RAW bytes"
  }

  category: SCHEMA_CATEGORY {
    shape: sql_table
    game: TEXT {constraint: [primary_key; foreign_key]}
    id: TEXT {constraint: primary_key}
    select: "one or any"
    install_root: "a token, never a path"
  }

  motd: "MOTD — motd/<lang>.txt" {
    shape: sql_table
    lang: "TEXT [a-z]{2,8}, en fallback" {constraint: primary_key}
  }

  conflicts: "CONFLICT_RECORD — reports/conflicts-<day>.jsonl" {
    shape: sql_table
    line: "day + line, append-only" {constraint: primary_key}
    received_at: "INTEGER — the server's clock"
    game: TEXT {constraint: foreign_key}
    installer: "TEXT — its version"
    conflicts: "file + packages[] in install order"
  }

  game -> directory: "contains 1 : 0..*"
  directory -> package: "packages/ 1 : 0..*"
  package <- sidecar: "describes 0..1 : 1"
  sidecar -> requires: "requires[] 1 : 0..*"
  game -> schema: "1 : 1"
  schema -> category: "declares 1 : 1..*"
}

wire: "Protocol documents — shared/, serde only" {
  class: wire

  manifest: "MANIFEST — data/manifest.json, generated by manifest gen" {
    shape: sql_table
    class: logical
    packages: "PackageInfo[]"
    schemas: "game → GameSchema"
  }

  key_status: "KeyStatus — 200 body of GET /whoami" {
    shape: sql_table
    expires_at: INTEGER NULL
  }

  report: "ConflictReport — POST /report/conflict, 8 KiB, no identity" {
    shape: sql_table
    game: TEXT
    installer: TEXT
    conflicts: "file + packages[]"
  }
}

auth.grants.directory -> data.directory.name: "logical FK: resolved against the catalogue" {class: logical}
wire.manifest -> data.package: "generated from (a pure function of zips, sidecars, schemas)" {class: logical}
wire.manifest -> data.schema: "carries each game's hash" {class: logical}
wire.report -> data.conflicts: "appended as one line"

guide: |md
  **Reading the model**

  - A package is identified by **game + directory + name**, never by name alone.
  - `name` is a lookup key, never joined onto a filesystem path.
  - Delete a sidecar key and it is gone at the next `manifest gen`.
  - `GRANTS.directory` has no constraint: the name is resolved against the catalogue.
  - Conflict records are diagnostics; only `manifest gen` warnings come from them.
| {shape: page; near: bottom-center}
